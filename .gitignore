# BEGIN oh-my-opencode-slim clonedeps
.slim/clonedeps/repos/
# END oh-my-opencode-slim clonedeps

# Simulation logs
*.log
.slim/*.log

# Quartus generated databases and reports
db/
incremental_db/
output_files/
*.rpt

# Programmer bitstream artifacts
*.sof
*.pof
*.jic
*.cdf
*.sld

# Scratch Quartus projects left in the repository root.
# The curated project lives in quartus/ and must stay tracked, so this is
# root-anchored and then negated for that directory.
# Example of what this hides: R01.qpf R02.qpf pa.qpf pb.qpf pc.qpf ptest.qpf
/*.qpf
/*.qsf
!/quartus/*.qpf
!/quartus/*.qsf

# Vivado journals and tool scratch.
# Vivado writes these into whatever directory it is launched from, so a run
# started in the repository root drops them there.
# Covers vivado.jou and vivado_<pid>.backup.jou.
*.jou
*.str
.Xil/
*.cache
*.hw
*.runs/
*.gen/
build/

# PS flow (tools/ps) build outputs.  The scripts and the application source are
# tracked; the Vivado project, its reports, the bitstream, the .hdf, the SDK
# workspace, BOOT.bin and the derived XDC are generated by run_build.ps1 /
# run_sdk.ps1 and are not committed.
/tools/ps/proj/
/tools/ps/out/
/tools/ps/sdk_ws/
/tools/ps/NA/
/tools/ps/BOOT.bin
/tools/ps/*.bit
/tools/ps/*.hdf
/tools/ps/*.dcp
/tools/ps/*.log
