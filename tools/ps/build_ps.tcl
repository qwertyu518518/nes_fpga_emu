# =============================================================================
# build_ps.tcl -- the PS half of runtime cartridge loading, Vivado 2018.3.
#
# This is an ADDITIONAL flow, not a replacement for anything.  It builds a block
# design that connects the Zynq PS to the repository's hand-written AXI4-Lite
# slave, implements it with the real nes_zynq_top as the PL logic, writes the
# bitstream and exports the .hdf the SDK flow consumes.  The PL-only non-project
# recipe (build.tcl / finish.tcl over a frozen nes_zynq_top) is untouched and
# stays the primary build; see tools/ps/README.md for how the two coexist.
#
# It is a project-mode flow for one reason only: a block design is a project
# object.  That has two documented consequences this script handles explicitly:
#   * project-mode synthesis runs with CWD set to the run directory, so a
#     committed relative $readmemh path does NOT resolve and the ROM silently
#     collapses -- handled with a STEPS.SYNTH_DESIGN.TCL.PRE hook that stages
#     the committed hex into the run directory (and absolute module parameters,
#     belt and braces);
#   * the XDC is derived, not hand-edited: the board pins come from the
#     repository XDC with only the two PS-owned pins removed.
#
# Run through tools/ps/run_build.ps1, which sets the CWD to this directory.
# Modes (env PS_MODE): bdonly | synthonly | full (default full).
# =============================================================================

set part xc7z020clg400-2
set root [file normalize [pwd]]
set repo [file normalize [file join $root .. ..]]
set outd [file join $root out]
file mkdir $outd

puts "PS_BUILD root=$root"
puts "PS_BUILD repo=$repo"
puts "PS_BUILD vivado=[version -short] part=$part"

if {![info exists ::env(PS_MODE)]} { set ::env(PS_MODE) full }
set mode $::env(PS_MODE)
puts "PS_BUILD mode=$mode"

# ---------------------------------------------------------------- RTL list
set rtl_files {}
foreach d {nes_core nes_core/apu nes_core/bus nes_core/cart nes_core/controller \
           nes_core/cpu nes_core/mapper nes_core/peripheral nes_core/ppu \
           nes_core/system nes_core/video platform/zynq} {
    set rtl_files [concat $rtl_files [lsort [glob -nocomplain [file join $repo rtl $d *.v]]]]
}
puts "PS_BUILD RTL source count = [llength $rtl_files]"
foreach f $rtl_files {
    if {[string match "*axi_lite_regs.v" $f] || [string match "*nes_zynq_top.v" $f] || [string match "*nes_cart_load_bridge.v" $f]} {
        puts "  PS_BUILD KEY-RTL $f [file size $f] bytes"
    }
}

# --------------------------------------------------- derived constraint file
# The repository XDC is the source of every pin.  The PS now owns sys_clk (fed
# by FCLK_CLK0) and sys_rst_n (fed by the PS peripheral reset), so exactly those
# two pin lines and the sys_clk create_clock are removed; everything else is
# carried through byte for byte.  The aud_bclk generated clock's -source is
# retargeted hierarchically because nes_zynq_top now sits below the block-design
# wrapper.  A scoped reset-distribution block and the bridge CDC bounds are
# appended; see the comments they carry in the generated file.
set src_xdc [file join $repo rtl platform zynq nes_zynq_top.xdc]
set ps_xdc  [file join $outd ps_zynq_top.xdc]

set fh [open $src_xdc r]
set xdata [read $fh]
close $fh

set out_lines {}
set dropped 0
foreach line [split $xdata "\n"] {
    set keep 1
    if {[string match "create_clock -name sys_clk *" [string trimleft $line]]} {
        set keep 0
    } elseif {[string match "set_property *" [string trimleft $line]]} {
        if {[string first {[get_ports sys_clk]} $line] >= 0}   { set keep 0 }
        if {[string first {[get_ports sys_rst_n]} $line] >= 0} { set keep 0 }
    }
    if {$keep == 1} {
        if {[string first {-source [get_pins u_audio_i2s/bclk_int_reg/C]} $line] >= 0} {
            set line [string map [list \
                {-source [get_pins u_audio_i2s/bclk_int_reg/C]} \
                {-source [get_pins -hierarchical -filter {NAME =~ */u_audio_i2s/bclk_int_reg/C}]}] $line]
        }
        lappend out_lines $line
    } else {
        incr dropped
    }
}

# The appended block is ONE braced word so no substitution happens inside it,
# which is what lets it carry [get_pins ...] and $_var literally.  Braces inside
# must balance; comments here deliberately contain none.
set appended {
# =============================================================================
# DERIVED FILE -- generated by tools/ps/build_ps.tcl from
# rtl/platform/zynq/nes_zynq_top.xdc.  Do not edit; edit the source XDC.
#
# Dropped (now owned by the PS): the sys_clk PACKAGE_PIN line, the sys_rst_n
# PACKAGE_PIN line, and the sys_clk create_clock.  FCLK_CLK0 supplies sys_clk
# and the PS peripheral reset supplies sys_rst_n.  Every board pin, the lcd_clk
# create_clock, the aud_bclk generated clock and the set_max_delay CDC bounds
# are carried through unchanged.
# =============================================================================
#
# PS RESET DISTRIBUTION INTO THE FABRIC RESET SYNCHRONISERS
#
# The PS reset leaves proc_sys_reset synchronised to clk_fpga_0 and is handed to
# each clock domain's own inline reset synchroniser in nes_zynq_top.v.  The
# synchronous release is intra-domain and fully timed; the ASYNCHRONOUS
# ASSERTION is the only arc that crosses clk_fpga_0 -> mmcm_* and has no real
# timing requirement (a two-flop synchroniser absorbs its arrival phase).
#
# A bounded treatment was measured FIRST and does NOT work: set_max_delay
# -datapath_only governs the setup/hold data path and does not bound
# recovery/removal, so the async_default failures stayed at a 0.106 ns
# requirement.  The arcs therefore get the standard reset-distribution
# treatment: a SCOPED false path, by destination pin name, on exactly the
# first-stage reset-synchroniser async pins below.  It does not touch a second
# stage, a per-domain reset tree, any data path, or any non-synchroniser reset.
set _ps7_rst_sync_pins [get_pins -quiet -hierarchical -filter {
    (REF_PIN_NAME == PRE || REF_PIN_NAME == CLR) &&
    (NAME =~ *rst_sys_q_reg*        || NAME =~ *rst_core_q_reg* ||
     NAME =~ *rst_lcd_q_reg*        || NAME =~ *rst_hdmi_q_reg* ||
     NAME =~ *locked_*_q?_reg*      || NAME =~ *hdmi_locked_q?_reg* ||
     NAME =~ *codec_cfg_*_q?_reg*   || NAME =~ *btn_meta_q_reg* ||
     NAME =~ *btn_sync_q_reg*       || NAME =~ *ps_hold_core_q?_reg*)}]
set_false_path -to $_ps7_rst_sync_pins
#
# The platform-top core-domain pixel pipeline (px_we_q / px_x_q / px_y_q /
# px_pal_q / vid_we_q / vid_in_x_q / vid_in_y_q / vid_in_rgb_q) still takes the
# raw board reset sys_rst_n as its asynchronous clear.  With the PS owning
# sys_rst_n, that makes its recovery/removal arcs clk_fpga_0 -> mmcm_core_clk,
# which is the same inherently-asynchronous assertion as the synchroniser pins
# above and has no real requirement.  The earlier probe removed these arcs in
# RTL by pointing the pipeline at rst_core; this task is constrained not to
# change rtl/ behaviour, so the same scoped false path is extended to exactly
# these named registers' async pins instead.  It is still NOT a blanket false
# path: only the named pipeline registers are listed.
set _ps7_pipe_rst_pins [get_pins -quiet -hierarchical -filter {
    (REF_PIN_NAME == PRE || REF_PIN_NAME == CLR) &&
    (NAME =~ *px_we_q_reg*       || NAME =~ *px_x_q_reg* ||
     NAME =~ *px_y_q_reg*        || NAME =~ *px_pal_q_reg* ||
     NAME =~ *vid_we_q_reg*      || NAME =~ *vid_in_x_q_reg* ||
     NAME =~ *vid_in_y_q_reg*    || NAME =~ *vid_in_rgb_q_reg*)}]
set_false_path -to $_ps7_pipe_rst_pins
#
# PS CARTRIDGE LOAD BRIDGE CDC BOUNDS
#
# u_ps_load_bridge carries the load bundle from clk_fpga_0 into mmcm_core_clk
# with a bundled-data toggle handshake (see nes_cart_load_bridge.v).  The two
# clocks are MMCM-related, so Vivado computes a near-zero setup window for
# these crossing paths and they fail by construction, exactly like the touch
# buttons and codec cfg_done above.  They get the repository's synchroniser
# idiom: a bounded set_max_delay -datapath_only (NOT a false path), scoped to
# the launch registers and the first-stage destination registers.  20.000 ns
# is the tighter of the two periods (clk_fpga_0 is 20 ns).  The launch set
# includes axi_lite_regs' CTRL register, which drives host_load_enable.  The
# bundle is only sampled on a request edge, at least two core clocks after the
# toggle moved, which is why a bounded delay is sufficient here.  CTRL also
# drives the console-hold synchroniser, which is in the destination set so the
# hold crossing is bounded by the same statement.
set _ps_ld_host_regs [get_cells -quiet -hierarchical -filter {
    NAME =~ *axi_lite_regs_0/*reg_ctrl_reg*     ||
    NAME =~ *u_ps_load_bridge/req_toggle_reg*   ||
    NAME =~ *u_ps_load_bridge/req_target_q_reg* ||
    NAME =~ *u_ps_load_bridge/req_addr_q_reg*   ||
    NAME =~ *u_ps_load_bridge/req_data_q_reg*}]
set _ps_ld_core_regs [get_cells -quiet -hierarchical -filter {
    NAME =~ *u_ps_load_bridge/req_sync1_reg*     ||
    NAME =~ *u_ps_load_bridge/load_en_s1_reg*    ||
    NAME =~ *u_ps_load_bridge/prg_ld_addr_r_reg* ||
    NAME =~ *u_ps_load_bridge/prg_ld_data_r_reg* ||
    NAME =~ *u_ps_load_bridge/chr_ld_addr_r_reg* ||
    NAME =~ *u_ps_load_bridge/chr_ld_data_r_reg* ||
    NAME =~ *u_ps_load_bridge/prg_ld_we_r_reg*   ||
    NAME =~ *u_ps_load_bridge/chr_ld_we_r_reg*   ||
    NAME =~ *ps_hold_core_q0_reg*}]
set_max_delay -datapath_only 20.000 -from $_ps_ld_host_regs -to $_ps_ld_core_regs
set_max_delay -datapath_only 20.000 -from [get_cells -quiet -hierarchical -filter {NAME =~ *u_ps_load_bridge/ack_toggle_r_reg*}] -to [get_cells -quiet -hierarchical -filter {NAME =~ *u_ps_load_bridge/ack_sync1_reg*}]
}

set fh [open $ps_xdc w]
foreach l $out_lines { puts $fh $l }
puts $fh $appended
close $fh
puts "PS_BUILD derived XDC $ps_xdc : [llength $out_lines] lines kept, $dropped dropped"

# ---------------------------------------------------------------- project
set proj [file join $root proj]
create_project -force ps_nes $proj -part $part
add_files -norecurse $rtl_files
add_files -fileset constrs_1 -norecurse $ps_xdc

# ================================================================ block design
create_bd_design system
current_bd_design system

# ---- PS7 -------------------------------------------------------------------
create_bd_cell -type ip -vlnv xilinx.com:ip:processing_system7:5.5 processing_system7_0
source [file join $root ps7_vendor_cfg.tcl]
set_property -dict $ps7_vendor_cfg [get_bd_cells processing_system7_0]

# The vendor config is the board's own example.  FCLK0 = 50 MHz, M_AXI_GP0 on,
# SD0 on MIO 40..45 without card detect, USB0 on MIO 28..39, UART0 on MIO 14/15.
set ps7_over [list \
    CONFIG.PCW_EN_CLK0_PORT             {1} \
    CONFIG.PCW_EN_RST0_PORT             {1} \
    CONFIG.PCW_FCLK_CLK0_BUF            {TRUE} \
    CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ {50} \
    CONFIG.PCW_USE_M_AXI_GP0            {1} \
    CONFIG.PCW_EN_USB0                  {1} \
    CONFIG.PCW_USB0_PERIPHERAL_ENABLE   {1} \
    CONFIG.PCW_USB0_USB0_IO             {MIO 28 .. 39} \
    CONFIG.PCW_USB0_RESET_ENABLE        {0} \
    CONFIG.PCW_SD0_GRP_CD_ENABLE        {0} \
    CONFIG.PCW_MIO_28_DIRECTION {inout} CONFIG.PCW_MIO_28_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_28_PULLUP {enabled} CONFIG.PCW_MIO_28_SLEW {slow} \
    CONFIG.PCW_MIO_29_DIRECTION {inout} CONFIG.PCW_MIO_29_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_29_PULLUP {enabled} CONFIG.PCW_MIO_29_SLEW {slow} \
    CONFIG.PCW_MIO_30_DIRECTION {inout} CONFIG.PCW_MIO_30_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_30_PULLUP {enabled} CONFIG.PCW_MIO_30_SLEW {slow} \
    CONFIG.PCW_MIO_31_DIRECTION {inout} CONFIG.PCW_MIO_31_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_31_PULLUP {enabled} CONFIG.PCW_MIO_31_SLEW {slow} \
    CONFIG.PCW_MIO_32_DIRECTION {inout} CONFIG.PCW_MIO_32_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_32_PULLUP {enabled} CONFIG.PCW_MIO_32_SLEW {slow} \
    CONFIG.PCW_MIO_33_DIRECTION {inout} CONFIG.PCW_MIO_33_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_33_PULLUP {enabled} CONFIG.PCW_MIO_33_SLEW {slow} \
    CONFIG.PCW_MIO_34_DIRECTION {inout} CONFIG.PCW_MIO_34_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_34_PULLUP {enabled} CONFIG.PCW_MIO_34_SLEW {slow} \
    CONFIG.PCW_MIO_35_DIRECTION {inout} CONFIG.PCW_MIO_35_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_35_PULLUP {enabled} CONFIG.PCW_MIO_35_SLEW {slow} \
    CONFIG.PCW_MIO_36_DIRECTION {in}    CONFIG.PCW_MIO_36_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_36_PULLUP {enabled} CONFIG.PCW_MIO_36_SLEW {slow} \
    CONFIG.PCW_MIO_37_DIRECTION {in}    CONFIG.PCW_MIO_37_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_37_PULLUP {enabled} CONFIG.PCW_MIO_37_SLEW {slow} \
    CONFIG.PCW_MIO_38_DIRECTION {out}   CONFIG.PCW_MIO_38_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_38_PULLUP {enabled} CONFIG.PCW_MIO_38_SLEW {slow} \
    CONFIG.PCW_MIO_39_DIRECTION {in}    CONFIG.PCW_MIO_39_IOTYPE {LVCMOS 3.3V} CONFIG.PCW_MIO_39_PULLUP {enabled} CONFIG.PCW_MIO_39_SLEW {slow} \
]
set_property -dict $ps7_over [get_bd_cells processing_system7_0]
puts "PS_BUILD PS7_CONFIG FCLK0=[get_property CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ [get_bd_cells processing_system7_0]] M_AXI_GP0=[get_property CONFIG.PCW_USE_M_AXI_GP0 [get_bd_cells processing_system7_0]]"

# ---- AXI3 -> AXI4-Lite protocol converter ----------------------------------
# M_AXI_GP0 is AXI3; the hand-written slave is AXI4-Lite.  This primitive is the
# required adapter (measured 418 LUT / 564 FF; far cheaper than a SmartConnect
# for a one-to-one register bank, which measured 2013 / 2539 in the first
# probe).
create_bd_cell -type ip -vlnv xilinx.com:ip:axi_protocol_converter:2.1 axi_pc
set_property -dict [list CONFIG.SI_PROTOCOL {AXI3} CONFIG.MI_PROTOCOL {AXI4LITE}] [get_bd_cells axi_pc]
puts "PS_BUILD PC SI=[get_property CONFIG.SI_PROTOCOL [get_bd_cells axi_pc]] MI=[get_property CONFIG.MI_PROTOCOL [get_bd_cells axi_pc]]"

# ---- the repository's hand-written AXI4-Lite slave --------------------------
create_bd_cell -type module -reference axi_lite_regs axi_lite_regs_0
puts "PS_BUILD REGS pins=[lsort [get_bd_pins -quiet axi_lite_regs_0/*]]"

# ---- reset ------------------------------------------------------------------
create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 rst_ps7_50M

# ---- the REAL repository top, as a module reference -------------------------
create_bd_cell -type module -reference nes_zynq_top nes_zynq_top_0

set cart  [file join $repo rtl nes_core cart]
set fwd   [string map [list \\ /] $cart]
set prg_abs [file join $fwd prg_placeholder.hex]
set chr_abs [file join $fwd chr_placeholder.hex]
foreach key {CONFIG.PRG_INIT_FILE PRG_INIT_FILE} { catch { set_property $key $prg_abs [get_bd_cells nes_zynq_top_0] } }
foreach key {CONFIG.CHR_INIT_FILE CHR_INIT_FILE} { catch { set_property $key $chr_abs [get_bd_cells nes_zynq_top_0] } }
catch { set_property -dict [list CONFIG.PRG_INIT_FILE $prg_abs CONFIG.CHR_INIT_FILE $chr_abs] [get_bd_cells nes_zynq_top_0] }

# ---- clocks and resets ------------------------------------------------------
connect_bd_net [get_bd_pins processing_system7_0/FCLK_CLK0] \
    [get_bd_pins processing_system7_0/M_AXI_GP0_ACLK] \
    [get_bd_pins rst_ps7_50M/slowest_sync_clk] \
    [get_bd_pins axi_pc/aclk] \
    [get_bd_pins axi_lite_regs_0/s_axi_aclk] \
    [get_bd_pins nes_zynq_top_0/sys_clk]
connect_bd_net [get_bd_pins processing_system7_0/FCLK_RESET0_N] [get_bd_pins rst_ps7_50M/ext_reset_in]
connect_bd_net [get_bd_pins rst_ps7_50M/peripheral_aresetn] \
    [get_bd_pins axi_pc/aresetn] \
    [get_bd_pins axi_lite_regs_0/s_axi_aresetn] \
    [get_bd_pins nes_zynq_top_0/sys_rst_n]

# ---- AXI -------------------------------------------------------------------
connect_bd_intf_net [get_bd_intf_pins processing_system7_0/M_AXI_GP0] [get_bd_intf_pins axi_pc/S_AXI]
connect_bd_intf_net [get_bd_intf_pins axi_pc/M_AXI] [get_bd_intf_pins axi_lite_regs_0/S_AXI]

# ---- the cartridge-load path: slave -> top -> bridge -> arrays --------------
connect_bd_net [get_bd_pins axi_lite_regs_0/pl_load_enable]  [get_bd_pins nes_zynq_top_0/ps_load_enable]
connect_bd_net [get_bd_pins axi_lite_regs_0/pl_console_hold] [get_bd_pins nes_zynq_top_0/ps_console_hold]
connect_bd_net [get_bd_pins axi_lite_regs_0/pl_ld_valid]     [get_bd_pins nes_zynq_top_0/ps_ld_valid]
connect_bd_net [get_bd_pins axi_lite_regs_0/pl_ld_target]    [get_bd_pins nes_zynq_top_0/ps_ld_target]
connect_bd_net [get_bd_pins axi_lite_regs_0/pl_ld_addr]      [get_bd_pins nes_zynq_top_0/ps_ld_addr]
connect_bd_net [get_bd_pins axi_lite_regs_0/pl_ld_data]      [get_bd_pins nes_zynq_top_0/ps_ld_data]
connect_bd_net [get_bd_pins nes_zynq_top_0/ps_ld_ready]      [get_bd_pins axi_lite_regs_0/pl_ld_ready]

# STATUS is documented as {24'b0, pl_status_in[7:0]}.  This design has no PL
# status bit worth publishing, so it is tied to 8'h00 rather than to a single
# board bit through a width adapter.  SCRATCH and ID, which are what the app
# actually checks, are unaffected.
create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 status_zero
set_property -dict [list CONFIG.CONST_WIDTH {8} CONFIG.CONST_VAL {0}] [get_bd_cells status_zero]
connect_bd_net [get_bd_pins status_zero/dout] [get_bd_pins axi_lite_regs_0/pl_status_in]

# ---- external PS interfaces ------------------------------------------------
make_bd_intf_pins_external [get_bd_intf_pins processing_system7_0/DDR]
make_bd_intf_pins_external [get_bd_intf_pins processing_system7_0/FIXED_IO]
foreach p [get_bd_intf_ports -quiet] {
    if {[string match "*DDR*" [get_property NAME $p]]}      { set_property name DDR      $p }
    if {[string match "*FIXED_IO*" [get_property NAME $p]]} { set_property name FIXED_IO $p }
}

# ---- NES board ports become external BD ports -------------------------------
# Every board port of nes_zynq_top except sys_clk and sys_rst_n, which the PS
# owns.  key / touch_key stay board inputs: the repo axi_lite_regs has no GPIO
# key output, so the controller keeps its own pins.
foreach p {key touch_key lcd_hs lcd_vs lcd_de lcd_bl lcd_clk lcd_rst \
           touch_rst_n touch_int \
           aud_bclk aud_dac_lrc aud_dacdat aud_mclk \
           tmds_clk_p tmds_clk_n} {
    make_bd_pins_external [get_bd_pins nes_zynq_top_0/$p]
}
foreach p {lcd_rgb tmds_data_p tmds_data_n} {
    make_bd_pins_external [get_bd_pins nes_zynq_top_0/$p]
}
foreach p {touch_scl touch_sda aud_iic_scl aud_iic_sda} {
    make_bd_pins_external [get_bd_pins nes_zynq_top_0/$p]
}
foreach p [get_bd_ports -quiet] {
    set n [get_property NAME $p]
    if {[string match "*_0" $n]} {
        set newn [string range $n 0 end-2]
        set_property name $newn $p
    }
}

# ---- addresses -------------------------------------------------------------
assign_bd_address
foreach s [get_bd_addr_segs -quiet -of_objects [get_bd_addr_spaces processing_system7_0/Data]] {
    if {[string match "*axi_lite_regs*" $s]} {
        set_property offset 0x41200000 $s
        set_property range  0x00010000 $s
        puts "PS_BUILD ADDRSEG $s -> 0x41200000/0x10000"
    }
}

validate_bd_design
save_bd_design
puts "PS_BUILD BD_DONE ports=[llength [get_bd_ports -quiet]]"

# ---------------------------------------------------------------- generate
generate_target all [get_files system.bd]
set wrapper [make_wrapper -files [get_files system.bd] -top -import]
puts "PS_BUILD WRAPPER $wrapper"
set_property top system_wrapper [current_fileset]

if {$mode eq "bdonly"} {
    puts "BD_ONLY_EXIT"
    exit 0
}

# Project-mode synthesis CWD is the run dir; stage the ROM for every synth run.
set pre [file join $outd pre_synth.tcl]
set fh [open $pre w]
puts $fh "# generated by tools/ps/build_ps.tcl -- stages the committed ROM paths"
puts $fh "# for project-mode synthesis, whose CWD is this run directory."
puts $fh "file mkdir rtl/nes_core/cart"
puts $fh "file copy -force \"[file join $fwd prg_placeholder.hex]\" rtl/nes_core/cart/"
puts $fh "file copy -force \"[file join $fwd chr_placeholder.hex]\" rtl/nes_core/cart/"
puts $fh "puts \"PRE_SYNTH cwd=\[pwd\] prg=\[file exists rtl/nes_core/cart/prg_placeholder.hex\]\""
close $fh
foreach r [get_runs -quiet] {
    if {[regexp {synth_1$} $r]} { catch { set_property STEPS.SYNTH_DESIGN.TCL.PRE $pre $r } }
}

# ================================================================ synthesis
launch_runs synth_1 -jobs 8
wait_on_run synth_1
set st [get_property STATUS [get_runs synth_1]]
puts "PS_BUILD SYNTH STATUS $st"
if {[string match -nocase "*ERROR*" $st]} { error "synthesis failed: $st" }

open_run synth_1 -name synth_1
write_checkpoint -force [file join $outd ps_synth.dcp]
report_utilization -file [file join $outd ps_util_synth.rpt]
report_utilization -hierarchical -file [file join $outd ps_util_synth_hier.rpt]

puts "PS_SYNTH_UTIL-BEGIN"
set fh [open [file join $outd ps_util_synth.rpt] r]; set sdata [read $fh]; close $fh
foreach line [split $sdata "\n"] {
    set t [string trim $line]
    foreach kw {Slice\ LUTs "Slice Registers" "LUT as Memory" "Block RAM Tile" RAMB18 RAMB36/FIFO} {
        if {[string match "| $kw *" $t]} { puts "  PS_SYNTH_UTIL $t" }
    }
}
puts "PS_SYNTH_UTIL-END"

if {$mode eq "synthonly"} {
    puts "SYNTH_ONLY_EXIT"
    exit 0
}

# ================================================================ implementation
launch_runs impl_1 -to_step write_bitstream -jobs 8
wait_on_run impl_1
set ist [get_property STATUS [get_runs impl_1]]
puts "PS_BUILD IMPL STATUS $ist"
if {[string match -nocase "*ERROR*" $ist]} { error "implementation failed: $ist" }

open_run impl_1
write_checkpoint -force [file join $outd ps_route.dcp]
report_timing_summary -delay_type min_max -max_paths 40 -file [file join $outd ps_timing_routed.rpt]
report_utilization -file [file join $outd ps_util_routed.rpt]
report_route_status -file [file join $outd ps_route_status.rpt]
report_drc -file [file join $outd ps_drc.rpt]
report_clocks -file [file join $outd ps_clocks.rpt]
check_timing -verbose -file [file join $outd ps_checktiming.rpt]

puts "PS_ROUTED_UTIL-BEGIN"
set fh [open [file join $outd ps_util_routed.rpt] r]; set sdata [read $fh]; close $fh
foreach line [split $sdata "\n"] {
    set t [string trim $line]
    foreach kw {Slice\ LUTs "LUT as Logic" "LUT as Memory" "Slice Registers" "Block RAM Tile" RAMB18 RAMB36/FIFO DSPS BUFGCTRL MMCME2_ADV} {
        if {[string match "| $kw *" $t]} { puts "  PS_ROUTED_UTIL $t" }
    }
}
puts "PS_ROUTED_UTIL-END"

set bit [glob -nocomplain [file join $proj ps_nes.runs impl_1 *.bit]]
if {[llength $bit]} {
    puts "PS_BITSTREAM [lindex $bit 0] [file size [lindex $bit 0]] bytes"
    catch { file copy -force [lindex $bit 0] [file join $outd ps_nes.bit] }
}
catch { write_hwdef -force [file join $outd ps_nes.hdf] }
puts "PS_BUILD_DONE"
exit 0
